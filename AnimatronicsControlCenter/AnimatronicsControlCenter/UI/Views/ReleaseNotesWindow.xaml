<Window
    x:Class="AnimatronicsControlCenter.UI.Views.ReleaseNotesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AnimatronicsControlCenter.Core.Models"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="40" VerticalAlignment="Top">
            <TextBlock Text="릴리즈 노트"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 버전 목록 -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,1,0">
                <ListView x:Name="VersionList"
                          ItemsSource="{x:Bind ViewModel.Releases}"
                          SelectedItem="{x:Bind ViewModel.SelectedRelease, Mode=TwoWay}"
                          SelectionMode="Single"
                          Padding="8,12,8,12">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ReleaseNote">
                            <StackPanel Spacing="2" Padding="4,8">
                                <TextBlock Text="{x:Bind DisplayVersion}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="{x:Bind Date}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- 선택한 버전의 내용 -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,0,56">
                <StackPanel MaxWidth="680"
                            HorizontalAlignment="Left"
                            Margin="56,40,40,0"
                            Spacing="0">

                    <!-- 헤더 -->
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.SelectedRelease.DisplayVersion, Mode=OneWay}"
                                   FontSize="44"
                                   FontWeight="SemiLight"/>
                        <Border VerticalAlignment="Center"
                                Margin="0,10,0,0"
                                Padding="9,3"
                                CornerRadius="10"
                                Background="{ThemeResource SystemControlBackgroundAccentBrush}"
                                Visibility="{x:Bind ToVisibility(ViewModel.IsSelectedInstalled), Mode=OneWay}">
                            <TextBlock Text="현재 설치됨"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.SelectedRelease.Date, Mode=OneWay}"
                               Margin="0,2,0,0"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <TextBlock Text="{x:Bind ViewModel.SelectedRelease.Headline, Mode=OneWay}"
                               Margin="0,28,0,0"
                               FontSize="21"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               LineHeight="30"/>

                    <Rectangle Height="1"
                               Margin="0,28,0,8"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- 항목 -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedRelease.Items, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ReleaseNoteItem">
                                <Grid Margin="0,24,0,0" ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="44" Height="44"
                                            CornerRadius="22"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource SystemControlBackgroundAccentBrush}">
                                        <FontIcon Glyph="{x:Bind Glyph}"
                                                  FontFamily="Segoe Fluent Icons"
                                                  FontSize="19"
                                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind Body}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="23"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
