<Page
    x:Class="AnimatronicsControlCenter.UI.Views.LogViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:infra="using:AnimatronicsControlCenter.Infrastructure"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{x:Bind Strings.Get('LogViewer_Title.Text', Strings.Code), Mode=OneWay}"
                   Style="{StaticResource TitleTextBlockStyle}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind Strings.Get('LogViewer_Date.Header', Strings.Code), Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"/>
                <CalendarDatePicker x:Name="DatePicker"
                                    MinWidth="180"
                                    DateChanged="OnDateChanged"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind Strings.Get('LogViewer_Device.Header', Strings.Code), Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"/>
                <TextBox Width="110"
                         Text="{x:Bind ViewModel.DeviceFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{x:Bind Strings.Get('LogViewer_DevicePlaceholder.PlaceholderText', Strings.Code), Mode=OneWay}"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind Strings.Get('LogViewer_Result.Header', Strings.Code), Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"/>
                <ComboBox x:Name="ResultBox" MinWidth="130" SelectedIndex="0" SelectionChanged="OnResultChanged">
                    <ComboBoxItem Content="{x:Bind Strings.Get('LogViewer_ResultAll', Strings.Code), Mode=OneWay}"/>
                    <ComboBoxItem Content="OK"/>
                    <ComboBoxItem Content="ERROR"/>
                </ComboBox>
            </StackPanel>

            <Button Content="{x:Bind Strings.Get('LogViewer_Refresh_Button', Strings.Code), Mode=OneWay}"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    VerticalAlignment="Bottom"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar IsOpen="{x:Bind ViewModel.IsTruncated, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Warning"
                     Message="{x:Bind Strings.Get('LogViewer_Truncated.Text', Strings.Code), Mode=OneWay}"/>
        </StackPanel>

        <Grid Grid.Row="3" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="12" Padding="12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind Strings.Get('LogViewer_Col_Time', Strings.Code), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Strings.Get('LogViewer_Col_Direction', Strings.Code), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/>
                <TextBlock Grid.Column="2" Text="{x:Bind Strings.Get('LogViewer_Col_Device', Strings.Code), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/>
                <TextBlock Grid.Column="3" Text="{x:Bind Strings.Get('LogViewer_Col_Command', Strings.Code), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/>
                <TextBlock Grid.Column="4" Text="{x:Bind Strings.Get('LogViewer_Col_Result', Strings.Code), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/>
                <TextBlock Grid.Column="5" Text="{x:Bind Strings.Get('LogViewer_Col_Elapsed', Strings.Code), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/>
            </Grid>

            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                      SelectionMode="None"
                      FontFamily="Consolas">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="infra:LogRecordRow">
                        <Grid ColumnSpacing="12" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Time}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Direction}"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind Device}"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind Command}"/>
                            <TextBlock Grid.Column="4" Text="{x:Bind Result}"/>
                            <TextBlock Grid.Column="5" Text="{x:Bind Elapsed}"/>
                            <TextBlock Grid.Column="6" Text="{x:Bind Raw}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
